# Optional. If unset, the app uses local Ollama at OLLAMA_BASE_URL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Local generation (default). Pull a model first: ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Retrieval
TOP_K=4
MIN_SCORE=0.08
CHUNK_SIZE=900
CHUNK_OVERLAP=120
KNOWLEDGE_DIR=data/knowledge
INDEX_DIR=data/index
